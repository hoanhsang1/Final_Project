{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://made-modified-prints-inclusion.trycloudflare.com/api/:path*"
    },
    {
      "source": "/departments",
      "destination": "https://made-modified-prints-inclusion.trycloudflare.com/departments"
    },
    {
      "source": "/departments/:path+",
      "destination": "https://made-modified-prints-inclusion.trycloudflare.com/departments/:path+"
    },
    {
      "source": "/positions",
      "destination": "https://made-modified-prints-inclusion.trycloudflare.com/positions"
    },
    {
      "source": "/positions/:path+",
      "destination": "https://made-modified-prints-inclusion.trycloudflare.com/positions/:path+"
    },
    {
      "source": "/permissions",
      "destination": "https://made-modified-prints-inclusion.trycloudflare.com/permissions"
    },
    {
      "source": "/permissions/:path+",
      "destination": "https://made-modified-prints-inclusion.trycloudflare.com/permissions/:path+"
    },
    {
      "source": "/students",
      "destination": "https://made-modified-prints-inclusion.trycloudflare.com/students"
    },
    {
      "source": "/students/:path+",
      "destination": "https://made-modified-prints-inclusion.trycloudflare.com/students/:path+"
    },
    {
      "source": "/classes",
      "destination": "https://made-modified-prints-inclusion.trycloudflare.com/classes"
    },
    {
      "source": "/classes/:path+",
      "destination": "https://made-modified-prints-inclusion.trycloudflare.com/classes/:path+"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
