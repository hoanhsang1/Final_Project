# Nguồn dữ liệu của ứng dụng:
#   api  = gọi backend thật qua API Gateway (mặc định)
#   mock = dữ liệu demo cục bộ, chỉ dùng cho kiểm thử giao diện độc lập
VITE_DATA_SOURCE=api

# Base path của API Gateway (để trống khi dùng proxy /api của Vite)
VITE_API_BASE_URL=/api/v1

# Host backend cho proxy của Vite dev server
VITE_API_PROXY_TARGET=http://localhost:8080

# Thanh công cụ chuyển vai trò demo chỉ hiện khi VITE_DATA_SOURCE=mock
VITE_ENABLE_DEMO_TOOLBAR=false
