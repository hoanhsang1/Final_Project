# Nguồn dữ liệu của ứng dụng:
#   mock = dữ liệu demo cục bộ (mặc định khi dev, KHÔNG gọi backend)
#   api  = gọi backend thật qua API Gateway
VITE_DATA_SOURCE=mock

# Base path của API Gateway (để trống khi dùng proxy /api của Vite)
VITE_API_BASE_URL=/api/v1

# Host backend cho proxy của Vite dev server
VITE_API_PROXY_TARGET=http://localhost:8080

# Hiển thị thanh công cụ chuyển vai trò demo (chỉ nên bật khi mock)
VITE_ENABLE_DEMO_TOOLBAR=true
