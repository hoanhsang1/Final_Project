@identity = http://localhost:8081
@people = http://localhost:8082
@facility = http://localhost:8084
@schedule = http://localhost:8083
@token = REPLACE_WITH_ACCESS_TOKEN
@refresh = REPLACE_WITH_REFRESH_TOKEN
@departmentId = REPLACE_WITH_DEPARTMENT_ID
@positionId = REPLACE_WITH_POSITION_ID
@userId = REPLACE_WITH_USER_ID

### Login: 200 {accessToken,refreshToken,tokenType,expiresIn}
POST {{identity}}/api/v1/auth/login
Content-Type: application/json

{"username":"owner@example.com","password":"REPLACE_WITH_PRIVATE_PASSWORD"}

### Create department: 201 {id,name,description,createdAt}
POST {{people}}/departments
Authorization: Bearer {{token}}
Content-Type: application/json

{"name":"Phòng đào tạo","description":"Quản lý đào tạo"}

### List departments: 200 array
GET {{people}}/departments
Authorization: Bearer {{token}}

### Update department: 200
PUT {{people}}/departments/{{departmentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{"name":"Phòng đào tạo","description":"Thông tin mới"}

### Permission catalog: 200 [{code,description}]
GET {{people}}/permissions
Authorization: Bearer {{token}}

### Create position: 201 {id,name,description,createdAt,permissions}
POST {{people}}/positions
Authorization: Bearer {{token}}
Content-Type: application/json

{"name":"Quản lý nhân sự","permissions":["PEOPLE_VIEW","PEOPLE_EDIT"]}

### List positions: 200 array
GET {{people}}/positions
Authorization: Bearer {{token}}

### Update position: 200; changes rights for every assignee
PUT {{people}}/positions/{{positionId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{"name":"Quản lý nhân sự","permissions":["PEOPLE_VIEW","PEOPLE_EDIT"]}

### OWNER creates MANAGER: 201 {member,temporaryPassword,mustChangePassword}
POST {{people}}/departments/{{departmentId}}/members
Authorization: Bearer {{token}}
Content-Type: application/json

{"username":"manager01","email":"manager@example.com","role":"MANAGER","positionIds":["{{positionId}}"]}

### Use temporary user's token: 204; log in again afterward
POST {{identity}}/api/v1/auth/change-password
Authorization: Bearer {{token}}
Content-Type: application/json

{"currentPassword":"REPLACE_WITH_TEMPORARY_PASSWORD","newPassword":"REPLACE_WITH_NEW_PRIVATE_PASSWORD"}

### MANAGER creates STAFF: 201; use manager token after password change
POST {{people}}/departments/{{departmentId}}/members
Authorization: Bearer {{token}}
Content-Type: application/json

{"username":"staff01","email":"staff@example.com","role":"STAFF","positionIds":["{{positionId}}"]}

### Members: 200 [{userId,departmentId,role,appointedBy,appointedAt,positionIds,permissions}]
GET {{people}}/departments/{{departmentId}}/members
Authorization: Bearer {{token}}

### Change positions: 200 member
PUT {{people}}/departments/{{departmentId}}/members/{{userId}}/positions
Authorization: Bearer {{token}}
Content-Type: application/json

{"positionIds":["{{positionId}}"]}

### Refresh after changed rights: 200 auth response; replace BOTH tokens
POST {{identity}}/api/v1/auth/refresh
Content-Type: application/json

{"refreshToken":"{{refresh}}"}

### Facility read: 200 array (FACILITY_MANAGE or OWNER)
GET {{facility}}/departments/{{departmentId}}/facilities
Authorization: Bearer {{token}}

### Schedule read: 200 array (SCHEDULE_VIEW or OWNER)
GET {{schedule}}/departments/{{departmentId}}/schedules
Authorization: Bearer {{token}}

### Remove appointment: 204; account remains
DELETE {{people}}/departments/{{departmentId}}/members/{{userId}}
Authorization: Bearer {{token}}

### Delete position: 204 or 409 POSITION_IN_USE
DELETE {{people}}/positions/{{positionId}}
Authorization: Bearer {{token}}

### Delete department: 204 or 409 DEPARTMENT_NOT_EMPTY
DELETE {{people}}/departments/{{departmentId}}
Authorization: Bearer {{token}}
