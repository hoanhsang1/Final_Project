@identity = http://localhost:8081
@people = http://localhost:8082
@facility = http://localhost:8084
@schedule = http://localhost:8083
@token = REPLACE_WITH_ACCESS_TOKEN
@refresh = REPLACE_WITH_REFRESH_TOKEN
@departmentId = REPLACE_WITH_DEPARTMENT_ID
@positionId = REPLACE_WITH_POSITION_ID
@userId = REPLACE_WITH_USER_ID
@studentId = REPLACE_WITH_STUDENT_ID
@classId = REPLACE_WITH_CLASS_ID

### Login: 200 {accessToken,refreshToken,tokenType,expiresIn}
POST {{identity}}/api/v1/auth/login
Content-Type: application/json

{"username":"owner@example.com","password":"REPLACE_WITH_PRIVATE_PASSWORD"}

### Create department with module: 201 {id,name,description,createdAt,modules}
POST {{people}}/departments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Phòng Đào tạo & Quản lý Sinh viên",
  "description": "Phụ trách quản lý sinh viên và lớp học",
  "moduleCodes": ["STUDENT_MANAGEMENT"]
}

### List departments: 200 array
GET {{people}}/departments
Authorization: Bearer {{token}}

### Get department details: 200
GET {{people}}/departments/{{departmentId}}
Authorization: Bearer {{token}}

### Update department: 200 (thay đổi toàn bộ danh sách module)
PUT {{people}}/departments/{{departmentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Phòng Đào tạo & Quản lý Sinh viên",
  "description": "Cập nhật mô tả mới",
  "moduleCodes": ["STUDENT_MANAGEMENT"]
}

### Permission catalog: 200 [{code,description,moduleCode}]
GET {{people}}/permissions
Authorization: Bearer {{token}}

### Create position with student management permissions: 201
POST {{people}}/positions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Giáo vụ Quản lý Sinh viên",
  "description": "Xem và chỉnh sửa sinh viên, lớp học",
  "permissions": ["STUDENT_VIEW", "STUDENT_CREATE", "STUDENT_EDIT", "CLASS_VIEW", "CLASS_CREATE", "CLASS_EDIT"]
}

### List positions: 200 array
GET {{people}}/positions
Authorization: Bearer {{token}}

### OWNER creates MANAGER: 201 {member,temporaryPassword,mustChangePassword}
POST {{people}}/departments/{{departmentId}}/members
Authorization: Bearer {{token}}
Content-Type: application/json

{"username":"manager01","email":"manager@example.com","role":"MANAGER","positionIds":["{{positionId}}"]}

### Use temporary user's token: 204; log in again afterward
POST {{identity}}/api/v1/auth/change-password
Authorization: Bearer {{token}}
Content-Type: application/json

{"currentPassword":"REPLACE_WITH_TEMPORARY_PASSWORD","newPassword":"REPLACE_WITH_NEW_PRIVATE_PASSWORD"}

### ==========================================
### Module STUDENT_MANAGEMENT: Sinh viên & Lớp học
### ==========================================

### Create Student: 201
POST {{people}}/students
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "studentCode": "SV2026001",
  "fullName": "Nguyễn Văn A",
  "dateOfBirth": "2004-05-15",
  "email": "nguyenvana@example.com",
  "phone": "0912345678",
  "status": "active"
}

### List Students: 200 (phân trang, tìm kiếm)
GET {{people}}/students?page=1&size=20&q=Nguyễn
Authorization: Bearer {{token}}

### Get Student Detail: 200
GET {{people}}/students/{{studentId}}
Authorization: Bearer {{token}}

### Update Student: 200
PUT {{people}}/students/{{studentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Nguyễn Văn A (Cập nhật)",
  "dateOfBirth": "2004-05-15",
  "email": "nguyenvana_new@example.com",
  "phone": "0987654321",
  "status": "active"
}

### Delete Student (xóa mềm): 204
DELETE {{people}}/students/{{studentId}}
Authorization: Bearer {{token}}

### Create School Class: 201
POST {{people}}/classes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "classCode": "CNTT-K18A",
  "name": "Công nghệ thông tin K18 Lớp A",
  "academicYear": "2024-2028",
  "status": "active"
}

### List School Classes: 200
GET {{people}}/classes?page=1&size=20&q=CNTT
Authorization: Bearer {{token}}

### Get School Class Detail: 200
GET {{people}}/classes/{{classId}}
Authorization: Bearer {{token}}

### Update School Class: 200
PUT {{people}}/classes/{{classId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Công nghệ thông tin K18 Lớp A (Phòng mới)",
  "academicYear": "2024-2028",
  "status": "active"
}

### Enroll Student into Class: 204
PUT {{people}}/classes/{{classId}}/students/{{studentId}}
Authorization: Bearer {{token}}

### List Students in Class: 200
GET {{people}}/classes/{{classId}}/students
Authorization: Bearer {{token}}

### Remove Student from Class: 204
DELETE {{people}}/classes/{{classId}}/students/{{studentId}}
Authorization: Bearer {{token}}

### Delete Class (phải gỡ hết sinh viên trước): 204
DELETE {{people}}/classes/{{classId}}
Authorization: Bearer {{token}}
