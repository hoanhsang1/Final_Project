        <mxCell id="p5-n32" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D9D9D9;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="385" y="906" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="p5-n33" value="class.view, class.approve_close, class.reopen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D9D9D9;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="605" y="906" width="630" height="42" as="geometry"/></mxCell>
