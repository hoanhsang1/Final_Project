<mxfile host="app.diagrams.net" agent="MEMS" version="24.7.17" type="device">
  <diagram id="p1" name="1. Tổng quan vai trò &amp; phạm vi">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1460" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p1-n1" value="MEMS — BẢN ĐỒ CHỨC NĂNG THEO VAI TRÒ" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1640" height="40" as="geometry"/></mxCell>
        <mxCell id="p1-n2" value="Nguồn sự thật: controller + @PreAuthorize/@RequirePermission, SQL phân quyền (10–26) và cấu hình chức vụ mặc định. Một tài khoản có thể có nhiều tầng: ROLE hệ thống + CHỨC VỤ (kèm bundle) + ỦY QUYỀN." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1640" height="34" as="geometry"/></mxCell>
        <mxCell id="p1-n3" value="TẦNG NỀN TẢNG — PLATFORM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1677FF;strokeColor=#1677FF;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="400" height="48" as="geometry"/></mxCell>
        <mxCell id="p1-n4" value="" style="rounded=1;fillColor=#E6F4FF;strokeColor=#1677FF;strokeWidth=1;opacity=35;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="400" height="1080" as="geometry"/></mxCell>
        <mxCell id="p1-n5" value="TẦNG TỔ CHỨC — ORGANIZATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FA8C16;strokeColor=#FA8C16;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="450" y="112" width="400" height="48" as="geometry"/></mxCell>
        <mxCell id="p1-n6" value="" style="rounded=1;fillColor=#FFF7E6;strokeColor=#FA8C16;strokeWidth=1;opacity=35;" vertex="1" parent="1"><mxGeometry x="450" y="160" width="400" height="1080" as="geometry"/></mxCell>
        <mxCell id="p1-n7" value="TẦNG PHÒNG BAN — DEPARTMENT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#52C41A;strokeColor=#52C41A;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="860" y="112" width="400" height="48" as="geometry"/></mxCell>
        <mxCell id="p1-n8" value="" style="rounded=1;fillColor=#F6FFED;strokeColor=#52C41A;strokeWidth=1;opacity=35;" vertex="1" parent="1"><mxGeometry x="860" y="160" width="400" height="1080" as="geometry"/></mxCell>
        <mxCell id="p1-n9" value="TẦNG CÁ NHÂN — SELF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#722ED1;strokeColor=#722ED1;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1270" y="112" width="400" height="48" as="geometry"/></mxCell>
        <mxCell id="p1-n10" value="" style="rounded=1;fillColor=#F9F0FF;strokeColor=#722ED1;strokeWidth=1;opacity=35;" vertex="1" parent="1"><mxGeometry x="1270" y="160" width="400" height="1080" as="geometry"/></mxCell>
        <mxCell id="p1-n11" value="SUPER_ADMIN&lt;br&gt;(Admin hệ thống — role nền tảng)&lt;br&gt;&lt;br&gt;• Duyệt / từ chối tổ chức đăng ký&lt;br&gt;• Tạm ngưng / kích hoạt lại tổ chức&lt;br&gt;• Bật/tắt module cho từng tổ chức&lt;br&gt;• Xem danh mục module hệ thống&lt;br&gt;• Xem danh sách &amp; chi tiết tài khoản&lt;br&gt;• Tạo tài khoản (không tạo SUPER_ADMIN)&lt;br&gt;• Đổi trạng thái: active / locked / disabled&lt;br&gt;• Đổi role tài khoản&lt;br&gt;• Reset mật khẩu tài khoản&lt;br&gt;• Xem nhật ký hệ thống (audit log)&lt;br&gt;&lt;br&gt;KHÔNG có nghiệp vụ phòng ban:&lt;br&gt;không tạo lớp, không duyệt đơn,&lt;br&gt;không dùng PeopleService." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1677FF;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="360" height="320" as="geometry"/></mxCell>
        <mxCell id="p1-n12" value="GIỚI HẠN CẦN NHỚ&lt;br&gt;&lt;br&gt;• /api/v1/organizations/**&lt;br&gt;• /api/v1/accounts/**&lt;br&gt;• /api/v1/audit-logs/**&lt;br&gt;chỉ role SUPER_ADMIN được gọi.&lt;br&gt;&lt;br&gt;• Không có org_id → không tham gia&lt;br&gt;luồng nghiệp vụ của tổ chức." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D4B106;strokeWidth=1;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontColor=#614700;" vertex="1" parent="1"><mxGeometry x="60" y="515" width="360" height="205" as="geometry"/></mxCell>
        <mxCell id="p1-n13" value="CHÚ GIẢI&lt;br&gt;&lt;br&gt;✓  được phép theo thiết kế&lt;br&gt;△  chỉ khi được cấp quyền / ủy quyền&lt;br&gt;—  không có trong thiết kế&lt;br&gt;&lt;br&gt;ROLE   = vai trò đăng nhập (JWT)&lt;br&gt;CHỨC VỤ = vị trí trong phòng ban,&lt;br&gt;mang permission + bundle&lt;br&gt;ỦY QUYỀN = Owner cấp quyền có thời hạn&lt;br&gt;cho Tổng quản lý" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4FF;strokeColor=#1677FF;strokeWidth=1;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontColor=#614700;" vertex="1" parent="1"><mxGeometry x="60" y="735" width="360" height="250" as="geometry"/></mxCell>
        <mxCell id="p1-n14" value="ROLE CŨ / CHƯA CÓ MÀN HÌNH&lt;br&gt;&lt;br&gt;• ORG_ADMIN&lt;br&gt;• ACADEMIC_STAFF&lt;br&gt;• FACILITY_STAFF&lt;br&gt;&lt;br&gt;Vẫn còn trong seed &amp; role_permission&lt;br&gt;(đã migration sang mã mới) nhưng&lt;br&gt;FE mapBackendRole trả null → không có&lt;br&gt;console tương ứng. Dùng OWNER /&lt;br&gt;MANAGER / STAFF + chức vụ thay thế." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#8C8C8C;strokeWidth=1;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontColor=#614700;" vertex="1" parent="1"><mxGeometry x="60" y="1000" width="360" height="185" as="geometry"/></mxCell>
        <mxCell id="p1-n15" value="OWNER / ORG_OWNER&lt;br&gt;(Chủ tổ chức)&lt;br&gt;&lt;br&gt;• Toàn quyền trong tổ chức — code bypass&lt;br&gt;  bằng hasRole('OWNER') ở mọi controller&lt;br&gt;• Phòng ban: xem / tạo / sửa / xóa&lt;br&gt;• Xem tác động khi đổi module phòng ban&lt;br&gt;• Chức vụ: xem / tạo / sửa / xóa / clone&lt;br&gt;• Nhân sự: xem / tạo / sửa / xóa / reset MK&lt;br&gt;• Gán &amp; thay đổi chức vụ cho nhân sự&lt;br&gt;• Bổ nhiệm / bãi nhiệm Tổng quản lý&lt;br&gt;• Tạo / sửa / thu hồi ủy quyền&lt;br&gt;• Dùng được toàn bộ khu Đào tạo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FA8C16;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="470" y="180" width="360" height="280" as="geometry"/></mxCell>
        <mxCell id="p1-n16" value="TỔNG QUẢN LÝ&lt;br&gt;(chức danh — KHÔNG phải role)&lt;br&gt;&lt;br&gt;• Owner bổ nhiệm / bãi nhiệm&lt;br&gt;• Chức danh 'Tổng quản lý' không kèm quyền&lt;br&gt;• Chỉ làm được việc trong phạm vi quyền&lt;br&gt;  được Owner ủy quyền (scope ORGANIZATION)&lt;br&gt;• Ủy quyền có thời hạn, có thể thu hồi&lt;br&gt;• KHÔNG được ủy quyền lại&lt;br&gt;• Xem quyền của mình tại /uy-quyen&lt;br&gt;&lt;br&gt;Ví dụ được ủy quyền:&lt;br&gt;employee.*, class.approve_close,&lt;br&gt;facility.manage… tùy Owner chọn." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FA8C16;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="470" y="480" width="360" height="270" as="geometry"/></mxCell>
        <mxCell id="p1-n17" value="QUẢN TRỊ VIÊN TỔ CHỨC&lt;br&gt;(chức vụ mặc định, scope ORGANIZATION)&lt;br&gt;&lt;br&gt;• Mang toàn bộ catalog quyền&lt;br&gt;• Gắn cả 4 bundle: HR, Đào tạo,&lt;br&gt;  Lịch học, Cơ sở vật chất&lt;br&gt;• Là 'cánh tay phải' của Owner&lt;br&gt;• Không phải role đăng nhập —&lt;br&gt;  vẫn là tài khoản STAFF/MANAGER + chức vụ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FA8C16;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="470" y="770" width="360" height="190" as="geometry"/></mxCell>
        <mxCell id="p1-n18" value="NGUYÊN TẮC&lt;br&gt;&lt;br&gt;Owner KHÔNG tự duyệt yêu cầu&lt;br&gt;đóng/hủy lớp do chính mình tạo&lt;br&gt;(SELF_APPROVAL_NOT_ALLOWED).&lt;br&gt;&lt;br&gt;Owner không bị chuyển phòng ban&lt;br&gt;(TRANSFER_OWNER_NOT_ALLOWED)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D4B106;strokeWidth=1;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontColor=#614700;" vertex="1" parent="1"><mxGeometry x="470" y="980" width="360" height="140" as="geometry"/></mxCell>
        <mxCell id="p1-n19" value="HR / NHÂN SỰ PHÒNG BAN&lt;br&gt;(role MANAGER + chức vụ + bundle HR)&lt;br&gt;&lt;br&gt;• Nhân sự: xem / tạo / sửa / xóa&lt;br&gt;• Gán &amp; thay đổi chức vụ&lt;br&gt;• Reset mật khẩu nhân sự&lt;br&gt;• Xem chi tiết nhạy cảm (email, SĐT)&lt;br&gt;• Tạo hồ sơ giáo viên&lt;br&gt;• Tạo yêu cầu nghỉ việc&lt;br&gt;• Duyệt / từ chối nghỉ việc&lt;br&gt;• Duyệt bước HR của chuyển phòng&lt;br&gt;• Phạm vi: phòng ban được gán" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#52C41A;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="880" y="180" width="360" height="300" as="geometry"/></mxCell>
        <mxCell id="p1-n20" value="GIÁO VỤ&lt;br&gt;(role STAFF + chức vụ, scope ORGANIZATION)&lt;br&gt;&lt;br&gt;• Sinh viên: xem / tạo / sửa / xóa&lt;br&gt;• Cấp tài khoản đăng nhập cho sinh viên&lt;br&gt;• Lớp học: xem / tạo / sửa / xóa&lt;br&gt;• Gán giáo viên &amp; phân công lại giáo viên&lt;br&gt;• Hủy lớp / gửi yêu cầu hủy lớp&lt;br&gt;• Gửi yêu cầu đóng lớp&lt;br&gt;• Mở lại lớp đã đóng&lt;br&gt;• Thêm / bớt sinh viên khỏi lớp&lt;br&gt;• Xem lịch sử trạng thái lớp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#52C41A;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="880" y="500" width="360" height="280" as="geometry"/></mxCell>
        <mxCell id="p1-n21" value="TRƯỞNG PHÒNG BAN&lt;br&gt;(role STAFF + chức vụ, scope DEPARTMENT)&lt;br&gt;&lt;br&gt;• Xem lớp&lt;br&gt;• Duyệt / từ chối HỦY lớp&lt;br&gt;• Duyệt / từ chối ĐÓNG lớp&lt;br&gt;• Mở lại lớp đã đóng&lt;br&gt;• Duyệt bước Trưởng phòng cũ / mới&lt;br&gt;  khi có yêu cầu chuyển phòng ban&lt;br&gt;• Không được tự duyệt yêu cầu của mình&lt;br&gt;• Người duyệt = trưởng phòng phụ trách&lt;br&gt;  module STUDENT_MANAGEMENT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#52C41A;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="880" y="800" width="360" height="250" as="geometry"/></mxCell>
        <mxCell id="p1-n22" value="NHÂN VIÊN CƠ SỞ VẬT CHẤT&lt;br&gt;(role STAFF + chức vụ, scope DEPARTMENT)&lt;br&gt;&lt;br&gt;• Phòng: xem / tạo / sửa / xóa&lt;br&gt;• Thiết bị: xem / tạo / sửa / xóa&lt;br&gt;• Báo sự cố&lt;br&gt;• Xem &amp; xử lý sự cố&lt;br&gt;• Cần module FACILITY_MANAGEMENT bật" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#52C41A;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="880" y="1070" width="360" height="140" as="geometry"/></mxCell>
        <mxCell id="p1-n23" value="GIÁO VIÊN&lt;br&gt;(role STAFF + chức vụ TEACHER)&lt;br&gt;&lt;br&gt;• Xem lớp được phân công (class.view)&lt;br&gt;• Xem sinh viên (student.view)&lt;br&gt;• Xem lịch dạy phòng ban (schedule.view)&lt;br&gt;• Xem lịch của tôi (/schedules/me)&lt;br&gt;• Báo sự cố nếu được cấp&lt;br&gt;  facility.issue.report&lt;br&gt;&lt;br&gt;KHÔNG được: tạo/sửa lớp, nhập điểm,&lt;br&gt;quản lý sinh viên, duyệt yêu cầu." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1290" y="180" width="360" height="250" as="geometry"/></mxCell>
        <mxCell id="p1-n24" value="GIÁO VIÊN — SELF&lt;br&gt;&lt;br&gt;• /schedules/me&lt;br&gt;• /lich-cua-toi&lt;br&gt;• Chỉ dùng subject trong JWT,&lt;br&gt;  không nhận userId từ client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1290" y="450" width="360" height="130" as="geometry"/></mxCell>
        <mxCell id="p1-n25" value="SINH VIÊN&lt;br&gt;(role STUDENT)&lt;br&gt;&lt;br&gt;• Xem hồ sơ của chính mình&lt;br&gt;  student.self_view&lt;br&gt;• Xem lớp của chính mình&lt;br&gt;  class.self_view&lt;br&gt;• Xem lịch của chính mình&lt;br&gt;  schedule.self_view&lt;br&gt;• Cổng /hoc-sinh&lt;br&gt;• Trang /lich-cua-toi&lt;br&gt;&lt;br&gt;KHÔNG vào console quản trị,&lt;br&gt;không CRUD bất kỳ dữ liệu nào." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1290" y="600" width="360" height="250" as="geometry"/></mxCell>
        <mxCell id="p1-n26" value="ĐIỀU KIỆN VÀO KHU ĐÀO TẠO&lt;br&gt;&lt;br&gt;canAccessAcademicArea = OWNER&lt;br&gt;hoặc có ít nhất 1 quyền trong:&lt;br&gt;employee.*, position.*, department.view,&lt;br&gt;class.*, student.*, schedule.*, facility.*&lt;br&gt;&lt;br&gt;Sinh viên có student.self_view&lt;br&gt;→ luôn vào /hoc-sinh, không vào /dao-tao." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9F0FF;strokeColor=#722ED1;strokeWidth=1;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontColor=#614700;" vertex="1" parent="1"><mxGeometry x="1290" y="870" width="360" height="200" as="geometry"/></mxCell>
        <mxCell id="p1-n27" value="LUỒNG PHỤ THUỘC CHÍNH" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="1260" width="1640" height="30" as="geometry"/></mxCell>
        <mxCell id="p1-n28" value="SUPER_ADMIN&lt;br&gt;Duyệt tổ chức" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="1300" width="260" height="58" as="geometry"/></mxCell>
        <mxCell id="p1-n29" value="OWNER&lt;br&gt;Toàn quyền tổ chức" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="380" y="1300" width="260" height="58" as="geometry"/></mxCell>
        <mxCell id="p1-n30" value="HR / GIÁO VỤ / TRƯỞNG PHÒNG&lt;br&gt;Quản lý theo chức vụ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="700" y="1300" width="260" height="58" as="geometry"/></mxCell>
        <mxCell id="p1-n31" value="GIÁO VIÊN&lt;br&gt;Dạy &amp; xem lớp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1140" y="1300" width="260" height="58" as="geometry"/></mxCell>
        <mxCell id="p1-e32" value="tạo / duyệt tổ chức" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-n28" target="p1-n29"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e33" value="tạo phòng ban, chức vụ, gán người" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-n29" target="p1-n30"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e34" value="phân công giáo viên" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-n30" target="p1-n31"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-n35" value="SINH VIÊN&lt;br&gt;Học lớp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1460" y="1300" width="200" height="58" as="geometry"/></mxCell>
        <mxCell id="p1-e36" value="dạy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-n31" target="p1-n35"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-n37" value="TỔNG QUẢN LÝ&lt;br&gt;Nhận ủy quyền từ Owner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FA8C16;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="380" y="1385" width="260" height="55" as="geometry"/></mxCell>
