  <diagram id="p4" name="4. Luồng nghiệp vụ chi tiết">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="3225" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p4-n1" value="4. CÁC LUỒNG NGHIỆP VỤ CHI TIẾT" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="35" y="16" width="1650" height="40" as="geometry"/></mxCell>
        <mxCell id="p4-n2" value="Ai làm bước nào, cần quyền gì, điều kiện dừng và kết quả cuối cùng." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="35" y="58" width="1650" height="28" as="geometry"/></mxCell>
        <mxCell id="p4-n3" value="1. VÒNG ĐỜI LỚP HỌC — Giáo vụ tạo, Trưởng phòng duyệt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#52C41A;strokeColor=#52C41A;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="35" y="100" width="1650" height="38" as="geometry"/></mxCell>
        <mxCell id="p4-n4" value="" style="rounded=1;fillColor=#F6FFED;strokeColor=#52C41A;strokeWidth=1;opacity=28;" vertex="1" parent="1"><mxGeometry x="35" y="138" width="1650" height="362" as="geometry"/></mxCell>
        <mxCell id="p4-n5" value="GIÁO VỤ tạo lớp&lt;br&gt;class.create&lt;br&gt;(status CHUA_BAT_DAU)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#52C41A;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="215" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n6" value="Cập nhật lớp&lt;br&gt;class.edit&lt;br&gt;trạng thái tự tính theo ngày&lt;br&gt;+ job đêm (luồng 10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#52C41A;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="300" y="160" width="215" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n7" value="Lớp còn sinh viên?&lt;br&gt;(studentCount &gt; 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F0;strokeColor=#CF1322;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="540" y="160" width="200" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n8" value="Còn SV:&lt;br&gt;Gửi yêu cầu hủy&lt;br&gt;class.cancel&lt;br&gt;(cancelState=PENDING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FA8C16;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="770" y="150" width="215" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n9" value="TRƯỞNG PHÒNG duyệt hủy&lt;br&gt;class.approve_close&lt;br&gt;không được tự duyệt&lt;br&gt;thiếu người duyệt → leo thang (luồng 6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FA8C16;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1010" y="150" width="230" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n10" value="DA_HUY&lt;br&gt;Lý do + lịch sử sự kiện" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CF1322;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1265" y="150" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n11" value="Không còn SV:&lt;br&gt;Hủy ngay&lt;br&gt;class.cancel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FA8C16;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="770" y="275" width="215" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n12" value="DA_HUY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CF1322;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1010" y="286" width="140" height="54" as="geometry"/></mxCell>
        <mxCell id="p4-n13" value="Giáo vụ gửi yêu cầu ĐÓNG&lt;br&gt;class.request_close&lt;br&gt;(closeState=PENDING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="375" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n14" value="TRƯỞNG PHÒNG duyệt đóng&lt;br&gt;class.approve_close&lt;br&gt;hoặc từ chối + lý do" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="375" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n15" value="closeState=CLOSED&lt;br&gt;status=DA_KET_THUC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="740" y="375" width="230" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n16" value="TRƯỞNG PHÒNG / OWNER mở lại&lt;br&gt;class.reopen&lt;br&gt;(closeState=NONE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1010" y="375" width="280" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-e17" value="class.edit / assign_teacher" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n5" target="p4-n6"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-16" as="offset"/></mxGeometry></mxCell>
