        <mxCell id="p5-n28" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9D9D9;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="385" y="864" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="p5-n29" value="class.view, student.view, schedule.view, schedule.attendance.mark, schedule.change_request.create" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9D9D9;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="605" y="864" width="630" height="42" as="geometry"/></mxCell>
        <mxCell id="p5-n30" value="Trưởng phòng ban" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D9D9D9;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="906" width="230" height="42" as="geometry"/></mxCell>
        <mxCell id="p5-n31" value="DEPARTMENT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D9D9D9;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="265" y="906" width="120" height="42" as="geometry"/></mxCell>
        <mxCell id="p5-n32" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D9D9D9;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="385" y="906" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="p5-n33" value="class.view, class.approve_close, class.reopen, schedule.change_request.approve (thiếu người → leo thang Tổng quản lý → OWNER)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D9D9D9;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="605" y="906" width="630" height="42" as="geometry"/></mxCell>
        <mxCell id="p5-n34" value="Nhân sự phòng ban" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9D9D9;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="948" width="230" height="42" as="geometry"/></mxCell>
        <mxCell id="p5-n35" value="DEPARTMENT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9D9D9;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="265" y="948" width="120" height="42" as="geometry"/></mxCell>
        <mxCell id="p5-n36" value="HR_MANAGEMENT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9D9D9;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="385" y="948" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="p5-n37" value="employee.*, position.*, department.view, class.view, student.view" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9D9D9;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="605" y="948" width="630" height="42" as="geometry"/></mxCell>
        <mxCell id="p5-n38" value="Nhân viên CSVC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D9D9D9;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="990" width="230" height="42" as="geometry"/></mxCell>
        <mxCell id="p5-n39" value="DEPARTMENT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D9D9D9;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="265" y="990" width="120" height="42" as="geometry"/></mxCell>
        <mxCell id="p5-n40" value="FACILITY_MANAGEMENT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D9D9D9;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="385" y="990" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="p5-n41" value="Toàn bộ facility.* (phòng, thiết bị, sự cố)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D9D9D9;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="605" y="990" width="630" height="42" as="geometry"/></mxCell>
        <mxCell id="p5-n42" value="Nhân viên" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9D9D9;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="1032" width="230" height="42" as="geometry"/></mxCell>
        <mxCell id="p5-n43" value="DEPARTMENT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9D9D9;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="265" y="1032" width="120" height="42" as="geometry"/></mxCell>
        <mxCell id="p5-n44" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9D9D9;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="385" y="1032" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="p5-n45" value="Không có quyền mặc định" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9D9D9;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="605" y="1032" width="630" height="42" as="geometry"/></mxCell>
        <mxCell id="p5-n46" value="ĐIỀU KIỆN MODULE &amp; PHẠM VI&lt;br&gt;&lt;br&gt;• STUDENT_MANAGEMENT: cần bật ở organization_module VÀ department_module của phòng ban xử lý.&lt;br&gt;• SCHEDULE_MANAGEMENT / FACILITY_MANAGEMENT: guard kiểm tra module trước mọi thao tác.&lt;br&gt;• HR_MANAGEMENT: module_code = NULL → không bị chặn theo module, nhưng vẫn lọc theo phòng ban.&lt;br&gt;• allowed_scopes: DEPARTMENT chỉ có hiệu lực trong phòng đang gán; ORGANIZATION áp cho toàn tổ chức.&lt;br&gt;• Ủy quyền chỉ nhận quyền có allowed_scopes chứa ORGANIZATION.&lt;br&gt;• [MỚI] Phòng học / thiết bị là tài nguyên cấp TỔ CHỨC (CSVC quản lý); phòng ban có SCHEDULE_MANAGEMENT được xếp vào mọi phòng đang hoạt động." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D4B106;strokeWidth=1;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontColor=#614700;" vertex="1" parent="1"><mxGeometry x="35" y="1095" width="970" height="175" as="geometry"/></mxCell>
        <mxCell id="p5-n47" value="THỨ TỰ KIỂM TRA KHI GỌI API&lt;br&gt;&lt;br&gt;1. JWT hợp lệ (hoặc internal key)&lt;br&gt;2. Role / authority (@PreAuthorize)&lt;br&gt;3. Permission + department scope&lt;br&gt;   (@RequirePermission / Actor)&lt;br&gt;4. Module đang bật&lt;br&gt;5. Trạng thái bản ghi (PENDING, ACTIVE…)&lt;br&gt;6. Quy tắc nghiệp vụ riêng&lt;br&gt;   (self-approval, trưởng phòng, owner…)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4FF;strokeColor=#1677FF;strokeWidth=1;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1030" y="1095" width="655" height="175" as="geometry"/></mxCell>
      <mxCell id="p5-v2-300" value="&lt;font color=&quot;#0958D9&quot;&gt;&lt;b&gt;[MỚI v2] QUYỀN CHUNG &amp;amp; BỔ SUNG&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Tài khoản &amp;amp; hồ sơ (mọi vai trò, không cần bundle): account.profile.view / edit · auth.change_password · auth.forgot_password (công khai)&lt;br&gt;• Thông báo &amp;amp; duyệt: notification.view · approval.inbox.view (việc chờ tôi duyệt)&lt;br&gt;• Tổ chức (OWNER): org.module.toggle (bật/tắt module Optional) · org.audit.view (nhật ký thay đổi tổ chức)&lt;br&gt;• Nền tảng (SUPER_ADMIN): module.catalog.manage (danh mục module, cờ lõi) · org.module.override (khóa module với một tổ chức)&lt;br&gt;• Nhân sự (HR_MANAGEMENT): teacher.change_status (đang dạy / tạm nghỉ / nghỉ việc)&lt;br&gt;• Muốn Giáo vụ xếp lịch: gán thêm bundle SCHEDULE_MANAGEMENT cho chức vụ Giáo vụ (chưa tạo chức vụ điều phối lịch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4FF;strokeColor=#1677FF;strokeWidth=1.5;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="35" y="1295" width="1650" height="170" as="geometry"/></mxCell></root>
    </mxGraphModel>
  </diagram>
  <diagram id="p6" name="6. Màn hình &amp; route theo vai trò">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p6-n1" value="6. MÀN HÌNH &amp; ROUTE THEO VAI TRÒ" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="35" y="16" width="1650" height="40" as="geometry"/></mxCell>
        <mxCell id="p6-n2" value="FE guard chỉ là UX; quyền thật do backend chặn bằng 401/403. Route nào cũng phải gọi đúng API được phép." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="35" y="58" width="1650" height="28" as="geometry"/></mxCell>
        <mxCell id="p6-n3" value="CÔNG KHAI / DÙNG CHUNG&lt;br&gt;&lt;br&gt;/dang-nhap                  Đăng nhập&lt;br&gt;/dang-ky                    Đăng ký tổ chức (UI)&lt;br&gt;/quen-mat-khau              Yêu cầu liên kết đặt lại&lt;br&gt;/dat-lai-mat-khau?token=…   Đặt mật khẩu mới&lt;br&gt;/doi-mat-khau               Bắt buộc khi còn MK tạm&lt;br&gt;/xem-thu/:vaiTro            Xem thử vai trò&lt;br&gt;/lich-cua-toi               Lịch của tôi (GV/SV)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="35" y="104" width="560" height="250" as="geometry"/></mxCell>
        <mxCell id="p6-n4" value="SUPER_ADMIN → /quan-tri&lt;br&gt;&lt;br&gt;/quan-tri                         Tổng quan&lt;br&gt;/quan-tri/to-chuc                 Tổ chức chờ duyệt&lt;br&gt;/quan-tri/to-chuc/tat-ca          Tất cả tổ chức&lt;br&gt;/quan-tri/to-chuc/:id             Chi tiết tổ chức&lt;br&gt;/quan-tri/to-chuc/:id/lich-su     Lịch sử duyệt&lt;br&gt;/quan-tri/module                  Danh mục module&lt;br&gt;/quan-tri/tai-khoan               Quản lý tài khoản&lt;br&gt;/quan-tri/tai-khoan/:id           Chi tiết tài khoản&lt;br&gt;/quan-tri/nhat-ky                 Nhật ký hệ thống" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1677FF;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="35" y="374" width="560" height="300" as="geometry"/></mxCell>
        <mxCell id="p6-n5" value="OWNER → /to-chuc&lt;br&gt;(OwnerGuard: OWNER hoặc ORG_OWNER)&lt;br&gt;&lt;br&gt;/to-chuc                    Phòng ban&lt;br&gt;/to-chuc/phong-ban/:id      Chi tiết phòng ban&lt;br&gt;                            (nhân sự nằm trong đây)&lt;br&gt;/to-chuc/chuc-vu            Chức vụ + bundle&lt;br&gt;/to-chuc/uy-quyen           Tổng quản lý &amp; ủy quyền" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FA8C16;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="35" y="694" width="560" height="220" as="geometry"/></mxCell>
        <mxCell id="p6-n6" value="KHU ĐÀO TẠO → /dao-tao&lt;br&gt;(AcademicGuard: OWNER hoặc có quyền nghiệp vụ)&lt;br&gt;&lt;br&gt;/dao-tao/nhan-su            Nhân sự phòng ban&lt;br&gt;/dao-tao/chuyen-phong       Yêu cầu chuyển phòng&lt;br&gt;/dao-tao/chuc-vu            Chức vụ (PeopleEditGuard)&lt;br&gt;/dao-tao/giao-vien          Giáo viên&lt;br&gt;/dao-tao/giao-vien/:id      Chi tiết giáo viên&lt;br&gt;/dao-tao/lop-hoc            Lớp học&lt;br&gt;/dao-tao/lop-hoc/:id        Chi tiết lớp + vòng đời&lt;br&gt;/dao-tao/sinh-vien          Sinh viên&lt;br&gt;/dao-tao/lich-hoc           Lịch phòng ban&lt;br&gt;/dao-tao/lich-cua-toi       Lịch của tôi&lt;br&gt;/dao-tao/co-so-vat-chat     Phòng &amp; thiết bị" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#52C41A;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="35" y="934" width="560" height="330" as="geometry"/></mxCell>
        <mxCell id="p6-n7" value="SELF&lt;br&gt;&lt;br&gt;/sinh-vien       Cổng sinh viên&lt;br&gt;                  (student.self_view)&lt;br&gt;/uy-quyen        Quyền đang được ủy quyền&lt;br&gt;                  (mọi thành viên tổ chức)&lt;br&gt;/lich-cua-toi    Lịch của chính mình&lt;br&gt;                  (giáo viên &amp; sinh viên)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="104" width="350" height="200" as="geometry"/></mxCell>
        <mxCell id="p6-n8" value="ĐIỀU HƯỚNG SAU ĐĂNG NHẬP" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1000" y="104" width="650" height="30" as="geometry"/></mxCell>
        <mxCell id="p6-n9" value="SUPER_ADMIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;strokeWidth=1.5;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1000" y="145" width="330" height="62" as="geometry"/></mxCell>
        <mxCell id="p6-n10" value="/quan-tri" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1677FF;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1350" y="145" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="p6-n11" value="OWNER / ORG_OWNER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;strokeWidth=1.5;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1000" y="217" width="330" height="62" as="geometry"/></mxCell>
        <mxCell id="p6-n12" value="/to-chuc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1677FF;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1350" y="217" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="p6-n13" value="Có quyền khu Đào tạo&lt;br&gt;(employee.*, class.*, student.*…)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;strokeWidth=1.5;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1000" y="289" width="330" height="62" as="geometry"/></mxCell>
        <mxCell id="p6-n14" value="/dao-tao" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1677FF;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1350" y="289" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="p6-n15" value="Có student.self_view" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;strokeWidth=1.5;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1000" y="361" width="330" height="62" as="geometry"/></mxCell>
        <mxCell id="p6-n16" value="/sinh-vien" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1677FF;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1350" y="361" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="p6-n17" value="Role không có màn hình" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;strokeWidth=1.5;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1000" y="433" width="330" height="62" as="geometry"/></mxCell>
        <mxCell id="p6-n18" value="/xem-thu/{role}&lt;br&gt;hoặc thông báo chưa hỗ trợ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1677FF;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1350" y="433" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="p6-n19" value="MENU KHU ĐÀO TẠO ĐƯỢC LỌC THEO QUYỀN&lt;br&gt;&lt;br&gt;• Nhân sự        ← employee.view&lt;br&gt;• Chuyển phòng   ← employee.transfer / approve_transfer / view&lt;br&gt;• Giáo viên      ← employee.view / employee.edit&lt;br&gt;• Lớp học        ← class.view&lt;br&gt;• Sinh viên      ← student.view&lt;br&gt;• Lịch học       ← schedule.view&lt;br&gt;• Lịch của tôi   ← schedule.self_view&lt;br&gt;• Cơ sở vật chất ← bất kỳ facility.*&lt;br&gt;• Chức vụ        ← position.manage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6FFED;strokeColor=#52C41A;strokeWidth=1;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1000" y="520" width="650" height="260" as="geometry"/></mxCell>
        <mxCell id="p6-n20" value="GHI NHỚ&lt;br&gt;&lt;br&gt;• Ẩn menu/nút KHÔNG phải bảo mật.&lt;br&gt;• Mọi endpoint đều kiểm lại role + permission.&lt;br&gt;• ORG_ADMIN, ACADEMIC_STAFF, FACILITY_STAFF&lt;br&gt;  DEPRECATED (không cấp mới, dọn khỏi seed).&lt;br&gt;• Tài khoản còn mật khẩu tạm bị đẩy sang&lt;br&gt;  /doi-mat-khau trước khi vào console." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D4B106;strokeWidth=1;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontColor=#614700;" vertex="1" parent="1"><mxGeometry x="1000" y="810" width="650" height="180" as="geometry"/></mxCell>
      <mxCell id="p6-v2-301" value="&lt;font color=&quot;#0958D9&quot;&gt;&lt;b&gt;[MỚI v2] ROUTE BỔ SUNG&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Dùng chung (mọi vai trò đăng nhập)&lt;/b&gt;&lt;br&gt;/ho-so                  Hồ sơ cá nhân + đổi mật khẩu&lt;br&gt;/thong-bao              Hộp thông báo&lt;br&gt;/viec-cho-duyet         Việc chờ tôi duyệt&lt;br&gt;&lt;br&gt;&lt;b&gt;SUPER_ADMIN → /quan-tri&lt;/b&gt;&lt;br&gt;/quan-tri/module        thêm / sửa module, cờ lõi&lt;br&gt;/quan-tri/to-chuc/:id   thêm nút khóa module (ghi đè)&lt;br&gt;&lt;br&gt;&lt;b&gt;OWNER → /to-chuc&lt;/b&gt;&lt;br&gt;/to-chuc/module         Bật / tắt module Optional&lt;br&gt;/to-chuc/nhat-ky        Nhật ký thay đổi tổ chức&lt;br&gt;&lt;br&gt;&lt;b&gt;KHU ĐÀO TẠO → /dao-tao&lt;/b&gt;&lt;br&gt;/dao-tao/mon-hoc               Danh mục môn học&lt;br&gt;/dao-tao/lich-hoc              mở rộng: lịch tuần / tháng + lọc&lt;br&gt;/dao-tao/lich-hoc/xep-lich-lap Xếp lịch lặp có xem trước&lt;br&gt;/dao-tao/diem-danh/:buoiId     Điểm danh buổi học&lt;br&gt;/dao-tao/yeu-cau-doi-lich      Đổi lịch / dạy bù&lt;br&gt;/dao-tao/lop-hoc?canPhanCong=1 Lớp cần phân công lại&lt;br&gt;&lt;br&gt;&lt;b&gt;SELF&lt;/b&gt;&lt;br&gt;/sinh-vien/chuyen-can   Chuyên cần của tôi&lt;br&gt;&lt;br&gt;&lt;b&gt;Menu mới ← quyền&lt;/b&gt;&lt;br&gt;• Môn học ← subject.view&lt;br&gt;• Điểm danh ← schedule.attendance.*&lt;br&gt;• Đổi lịch ← schedule.change_request.*&lt;br&gt;• Việc chờ duyệt ← approval.inbox.view" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4FF;strokeColor=#1677FF;strokeWidth=1.5;dashed=1;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="330" width="350" height="930" as="geometry"/></mxCell></root>
    </mxGraphModel>
  </diagram>
<diagram id="p7" name="7. Lộ trình triển khai (kế hoạch)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p7-t1" value="MEMS — LỘ TRÌNH TRIỂN KHAI v2" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="35" y="16" width="1650" height="40" as="geometry"/></mxCell><mxCell id="p7-t2" value="Làm tuần tự từng giai đoạn; xong giai đoạn nào thì kiểm tra DoD (xem file kế hoạch MEMS_ke_hoach_trien_khai.md) rồi mới sang giai đoạn kế tiếp." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="35" y="58" width="1650" height="30" as="geometry"/></mxCell><mxCell id="p7-h0" value="GIAI ĐOẠN 0 — DỌN NỀN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#8C8C8C;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="35" y="120" width="320" height="52" as="geometry"/></mxCell><mxCell id="p7-b0" value="• Chốt bảng ánh xạ module (SRS ↔ mã module ↔ bundle)&lt;br&gt;• OWNER bật/tắt module Optional; SUPER_ADMIN ghi đè/khóa&lt;br&gt;• Gộp &quot;Quản lý đào tạo&quot; vào chức vụ Giáo vụ&lt;br&gt;• Đổi route /hoc-sinh → /sinh-vien&lt;br&gt;• Dọn role cũ (ORG_ADMIN, ACADEMIC_STAFF, FACILITY_STAFF)&lt;br&gt;• Sửa README / api.md đã lỗi thời" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="35" y="172" width="320" height="420" as="geometry"/></mxCell><mxCell id="p7-h1" value="GIAI ĐOẠN 1 — TÀI KHOẢN &amp;amp; DUYỆT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08979C;strokeColor=#08979C;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="367" y="120" width="320" height="52" as="geometry"/></mxCell><mxCell id="p7-b1" value="• Hồ sơ cá nhân, quên / đặt lại mật khẩu&lt;br&gt;• Khóa tài khoản sau đăng nhập sai + mở khóa&lt;br&gt;• Reset MK / khóa–mở tài khoản sinh viên&lt;br&gt;• Duyệt leo thang (Trưởng phòng → Tổng quản lý → OWNER)&lt;br&gt;• &quot;Việc chờ tôi duyệt&quot; + hộp thông báo (FE)&lt;br&gt;• Đổi trạng thái giáo viên / sinh viên&lt;br&gt;• Môn học CRUD + khớp chuyên môn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#08979C;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="367" y="172" width="320" height="420" as="geometry"/></mxCell><mxCell id="p7-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7-h0" target="p7-h1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-h2" value="GIAI ĐOẠN 2 — XẾP LỊCH (NHÓM A)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1677FF;strokeColor=#1677FF;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="699" y="120" width="320" height="52" as="geometry"/></mxCell><mxCell id="p7-b2" value="• Phòng học là tài nguyên cấp tổ chức&lt;br&gt;• Xếp lịch lặp + xem trước buổi trùng&lt;br&gt;• Kiểm tra sức chứa phòng&lt;br&gt;• Liên động: hủy/đóng lớp, giáo viên nghỉ/chuyển phòng, phòng bảo trì&lt;br&gt;• Lịch tuần/tháng + lọc lớp/giáo viên/phòng&lt;br&gt;• Job đêm: trạng thái lớp tự động" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1677FF;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="699" y="172" width="320" height="420" as="geometry"/></mxCell><mxCell id="p7-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7-h1" target="p7-h2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-h3" value="GIAI ĐOẠN 3 — NHÓM B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#722ED1;strokeColor=#722ED1;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1031" y="120" width="320" height="52" as="geometry"/></mxCell><mxCell id="p7-b3" value="• Điểm danh buổi học&lt;br&gt;• Sinh viên xem chuyên cần&lt;br&gt;• Giáo viên xin đổi lịch / dạy bù / nghỉ + duyệt&lt;br&gt;• Job đêm: buổi học tự completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1031" y="172" width="320" height="420" as="geometry"/></mxCell><mxCell id="p7-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7-h2" target="p7-h3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-h4" value="GIAI ĐOẠN 4 — NHÓM C (SAU)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D48806;strokeColor=#D48806;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1363" y="120" width="320" height="52" as="geometry"/></mxCell><mxCell id="p7-b4" value="• Gợi ý xếp lịch tự động (thuật toán tham lam)&lt;br&gt;• Khung giờ bận / rảnh giáo viên + ngày nghỉ tổ chức&lt;br&gt;• Nhập sinh viên từ Excel&lt;br&gt;• Dashboard theo vai trò, báo cáo cơ bản" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D48806;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1363" y="172" width="320" height="420" as="geometry"/></mxCell><mxCell id="p7-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7-h3" target="p7-h4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-n1" value="ĐÃ CÓ SẴN TRONG CODE (chỉ cần mở rộng hoặc làm giao diện): thông báo (/notifications), hộp thư chuyển phòng (/transfer-requests/inbox), đổi mật khẩu (/auth/change-password), bật/tắt module (PUT /organizations/{id}/modules), trạng thái giảng dạy của giáo viên (teachingStatus), danh sách môn học (GET /subjects), gợi ý phòng trống, chặn trùng giáo viên / phòng / lớp.&lt;br&gt;&lt;br&gt;CHƯA CÓ: quên / đặt lại mật khẩu, khóa tài khoản sau đăng nhập sai (mới có cột DB), hồ sơ cá nhân, môn học CRUD, xếp lịch lặp, điểm danh, đổi lịch / dạy bù, job đêm, liên động lịch, lịch tuần/tháng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D4B106;strokeWidth=1;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontColor=#614700;" vertex="1" parent="1"><mxGeometry x="35" y="620" width="1650" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
