        <mxCell id="p4-e19" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n7" target="p4-n8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n8" target="p4-n9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e21" value="duyệt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n9" target="p4-n10"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-16" as="offset"/></mxGeometry></mxCell>
        <mxCell id="p4-e22" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n7" target="p4-n11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n11" target="p4-n12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n13" target="p4-n14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e25" value="duyệt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n14" target="p4-n15"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-16" as="offset"/></mxGeometry></mxCell>
        <mxCell id="p4-e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n15" target="p4-n16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-n27" value="Lưu ý: xóa lớp (class.delete) là thao tác riêng; hủy/đóng lớp đi qua state machine và ghi class_status_log + close event. SELF_APPROVAL_NOT_ALLOWED chặn người tạo yêu cầu tự duyệt. Hủy/đóng lớp kéo theo hủy các buổi chưa diễn ra (luồng 8)." style="text;html=1;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="60" y="465" width="1230" height="28" as="geometry"/></mxCell>
        <mxCell id="p4-n28" value="2. CHUYỂN PHÒNG BAN 4 BÊN — đủ 4 duyệt mới áp dụng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FA8C16;strokeColor=#FA8C16;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="35" y="520" width="1650" height="38" as="geometry"/></mxCell>
        <mxCell id="p4-n29" value="" style="rounded=1;fillColor=#FFF7E6;strokeColor=#FA8C16;strokeWidth=1;opacity=28;" vertex="1" parent="1"><mxGeometry x="35" y="558" width="1650" height="232" as="geometry"/></mxCell>
        <mxCell id="p4-n30" value="HR / người có quyền tạo&lt;br&gt;employee.transfer&lt;br&gt;cần Trưởng phòng 2 bên tồn tại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FA8C16;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="575" width="245" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n31" value="Bước 1: SOURCE_HEAD&lt;br&gt;Trưởng phòng CŨ duyệt&lt;br&gt;(theo chức danh)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FA8C16;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="325" y="575" width="240" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n32" value="Bước 2: TARGET_HEAD&lt;br&gt;Trưởng phòng MỚI duyệt&lt;br&gt;(theo chức danh)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FA8C16;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="590" y="575" width="240" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n33" value="Bước 3: HR duyệt&lt;br&gt;employee.approve_transfer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FA8C16;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="855" y="575" width="230" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n34" value="Bước 4: EMPLOYEE duyệt&lt;br&gt;chính người được chuyển&lt;br&gt;(xác nhận đồng ý)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FA8C16;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1110" y="575" width="240" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n35" value="Áp dụng trong 1 transaction:&lt;br&gt;đổi phòng + thu hồi assignment cũ&lt;br&gt;+ gắn nhãn lớp cần phân công lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#52C41A;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1380" y="565" width="270" height="96" as="geometry"/></mxCell>
        <mxCell id="p4-e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n30" target="p4-n31"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n31" target="p4-n32"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n32" target="p4-n33"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n33" target="p4-n34"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e40" value="đủ 4 APPROVED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n34" target="p4-n35"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-16" as="offset"/></mxGeometry></mxCell>
        <mxCell id="p4-n41" value="Bất kỳ bước nào REJECTED&lt;br&gt;→ dừng toàn bộ, gửi thông báo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CF1322;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="590" y="690" width="280" height="62" as="geometry"/></mxCell>
        <mxCell id="p4-e42" value="từ chối" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="p4-n32" target="p4-n41"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-n43" value="Người khởi tạo được hủy khi còn PENDING (/transfer-requests/{id}/cancel). OWNER không bị chuyển phòng. Một nhân sự chỉ có 1 yêu cầu PENDING tại một thời điểm." style="text;html=1;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="55" y="760" width="900" height="24" as="geometry"/></mxCell>
        <mxCell id="p4-n44" value="3. NGHỈ VIỆC — một bước duyệt bởi HR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CF1322;strokeColor=#CF1322;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="35" y="830" width="1650" height="38" as="geometry"/></mxCell>
        <mxCell id="p4-n45" value="" style="rounded=1;fillColor=#FFF1F0;strokeColor=#CF1322;strokeWidth=1;opacity=28;" vertex="1" parent="1"><mxGeometry x="35" y="868" width="1650" height="212" as="geometry"/></mxCell>
        <mxCell id="p4-n46" value="HR tạo yêu cầu nghỉ việc&lt;br&gt;employee.resign&lt;br&gt;(trong phòng ban)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CF1322;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="900" width="280" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n47" value="HR duyệt / từ chối&lt;br&gt;employee.approve_resignation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CF1322;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="390" y="900" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n48" value="Duyệt:&lt;br&gt;member → INACTIVE&lt;br&gt;+ offboarding giáo viên&lt;br&gt;+ gắn nhãn lớp cần phân công lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#52C41A;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="745" y="880" width="330" height="96" as="geometry"/></mxCell>
        <mxCell id="p4-n49" value="Từ chối:&lt;br&gt;giữ nguyên trạng thái&lt;br&gt;+ lý do" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CF1322;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="745" y="1005" width="330" height="66" as="geometry"/></mxCell>
        <mxCell id="p4-e50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n46" target="p4-n47"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e51" value="duyệt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n47" target="p4-n48"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
        <mxCell id="p4-e52" value="từ chối" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-n47" target="p4-n49"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-n53" value="4. BỔ NHIỆM &amp; ỦY QUYỀN TỔNG QUẢN LÝ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FA8C16;strokeColor=#FA8C16;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="35" y="1100" width="1650" height="38" as="geometry"/></mxCell>
        <mxCell id="p4-n54" value="" style="rounded=1;fillColor=#FFF7E6;strokeColor=#FA8C16;strokeWidth=1;opacity=28;" vertex="1" parent="1"><mxGeometry x="35" y="1138" width="1650" height="212" as="geometry"/></mxCell>
        <mxCell id="p4-n55" value="OWNER bổ nhiệm&lt;br&gt;chức danh 'Tổng quản lý'&lt;br&gt;(chỉ Owner gọi được API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FA8C16;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="1155" width="270" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n56" value="OWNER tạo ủy quyền&lt;br&gt;scope ORGANIZATION&lt;br&gt;thời hạn from/to&lt;br&gt;chọn tập quyền con" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FA8C16;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="365" y="1155" width="270" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n57" value="TỔNG QUẢN LÝ có quyền hiệu lực&lt;br&gt;= quyền chức vụ + quyền ủy quyền&lt;br&gt;(không vượt quá quyền Owner)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#52C41A;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="675" y="1155" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n58" value="OWNER sửa / thu hồi&lt;br&gt;(revoke có lý do, ghi audit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FA8C16;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1015" y="1155" width="270" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n59" value="Tổng quản lý KHÔNG được&lt;br&gt;ủy quyền lại cho người khác" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CF1322;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1320" y="1265" width="250" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-e60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n55" target="p4-n56"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n56" target="p4-n57"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e62" value="khi cần" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n57" target="p4-n58"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
        <mxCell id="p4-e63" value="cấm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-n57" target="p4-n59"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-n64" value="Chức danh 'Tổng quản lý' không tự kèm quyền. Mọi quyền đến từ bảng delegation; quyền phải nằm trong catalog và trong quyền hiện có của Owner." style="text;html=1;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="55" y="1252" width="1100" height="28" as="geometry"/></mxCell>
        <mxCell id="p4-n65" value="5. CẤP TÀI KHOẢN SINH VIÊN → CỔNG SELF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#722ED1;strokeColor=#722ED1;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="35" y="1400" width="1650" height="38" as="geometry"/></mxCell>
        <mxCell id="p4-n66" value="" style="rounded=1;fillColor=#F9F0FF;strokeColor=#722ED1;strokeWidth=1;opacity=28;" vertex="1" parent="1"><mxGeometry x="35" y="1438" width="1650" height="192" as="geometry"/></mxCell>
        <mxCell id="p4-n67" value="GIÁO VỤ tạo hồ sơ sinh viên&lt;br&gt;student.create" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="1455" width="290" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n68" value="Cấp tài khoản đăng nhập&lt;br&gt;student.create_account&lt;br&gt;(mật khẩu tạm)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="385" y="1455" width="290" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n69" value="SINH VIÊN đăng nhập&lt;br&gt;→ /sinh-vien&lt;br&gt;(student.self_view)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="715" y="1455" width="280" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n70" value="Xem hồ sơ + lớp của mình&lt;br&gt;/students/me&lt;br&gt;/students/me/classes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1035" y="1455" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="p4-n71" value="Xem lịch của mình&lt;br&gt;/schedules/me&lt;br&gt;/lich-cua-toi&lt;br&gt;(class.self_view + schedule.self_view)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1375" y="1440" width="260" height="96" as="geometry"/></mxCell>
        <mxCell id="p4-e72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n67" target="p4-n68"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n68" target="p4-n69"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e74" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n69" target="p4-n70"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e75" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-n70" target="p4-n71"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p4-v2-227" value="6. DUYỆT LEO THANG — không ai tự duyệt, thiếu người thì lên bậc trên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08979C;strokeColor=#08979C;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="35" y="1680" width="1650" height="38" as="geometry"/></mxCell><mxCell id="p4-v2-228" value="" style="rounded=1;fillColor=#E6FFFB;strokeColor=#08979C;strokeWidth=1;opacity=28;" vertex="1" parent="1"><mxGeometry x="35" y="1718" width="1650" height="245" as="geometry"/></mxCell><mxCell id="p4-v2-229" value="NGƯỜI YÊU CẦU&lt;br&gt;(Giáo vụ / HR / Giáo viên)&lt;br&gt;gửi yêu cầu cần duyệt:&lt;br&gt;hủy lớp, đóng lớp, đổi lịch…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#08979C;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="1743" width="270" height="90" as="geometry"/></mxCell><mxCell id="p4-v2-230" value="Bậc 1: TRƯỞNG PHÒNG&lt;br&gt;phụ trách module&lt;br&gt;(theo chức danh đang giữ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#08979C;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="365" y="1743" width="240" height="90" as="geometry"/></mxCell><mxCell id="p4-v2-231" value="Phòng có Trưởng phòng&lt;br&gt;và người đó KHÁC&lt;br&gt;người yêu cầu?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#08979C;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="645" y="1743" width="250" height="90" as="geometry"/></mxCell><mxCell id="p4-v2-232" value="Bậc 2: TỔNG QUẢN LÝ&lt;br&gt;(nếu được Owner ủy quyền)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#08979C;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="935" y="1743" width="240" height="90" as="geometry"/></mxCell><mxCell id="p4-v2-233" value="Bậc 3: OWNER&lt;br&gt;(luôn có)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#08979C;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1215" y="1743" width="200" height="90" as="geometry"/></mxCell><mxCell id="p4-v2-234" value="Duyệt / từ chối + lý do&lt;br&gt;ghi status_log / audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#08979C;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="645" y="1868" width="250" height="70" as="geometry"/></mxCell><mxCell id="p4-v2-235" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-229" target="p4-v2-230"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-236" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-230" target="p4-v2-231"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-237" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-231" target="p4-v2-232"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-238" value="vẫn thiếu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-232" target="p4-v2-233"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-239" value="Có → duyệt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-231" target="p4-v2-234"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-240" value="duyệt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-233" target="p4-v2-234"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-241" value="Quy tắc: người yêu cầu KHÔNG BAO GIỜ tự duyệt (SELF_APPROVAL_NOT_ALLOWED). OWNER tự thao tác thì thực hiện trực tiếp, không cần duyệt, nhưng bắt buộc ghi audit." style="text;html=1;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="55" y="1927" width="1560" height="30" as="geometry"/></mxCell><mxCell id="p4-v2-242" value="7. XẾP LỊCH LẶP CÓ XEM TRƯỚC — chặn cứng khi trùng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1677FF;strokeColor=#1677FF;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="35" y="1985" width="1650" height="38" as="geometry"/></mxCell><mxCell id="p4-v2-243" value="" style="rounded=1;fillColor=#E6F4FF;strokeColor=#1677FF;strokeWidth=1;opacity=28;" vertex="1" parent="1"><mxGeometry x="35" y="2023" width="1650" height="210" as="geometry"/></mxCell><mxCell id="p4-v2-244" value="Chọn lớp + giáo viên + phòng&lt;br&gt;+ thứ trong tuần + giờ&lt;br&gt;+ khoảng ngày (từ – đến)&lt;br&gt;schedule.create" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1677FF;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="2048" width="250" height="110" as="geometry"/></mxCell><mxCell id="p4-v2-245" value="Hệ thống SINH danh sách buổi&lt;br&gt;(bỏ ngày nghỉ của tổ chức)&lt;br&gt;POST …/schedules/preview" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1677FF;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="335" y="2048" width="250" height="110" as="geometry"/></mxCell><mxCell id="p4-v2-246" value="Kiểm tra từng buổi:&lt;br&gt;• trùng giáo viên / phòng / lớp&lt;br&gt;• sức chứa phòng ≥ sĩ số lớp&lt;br&gt;• phòng active, thiết bị không hỏng&lt;br&gt;• lớp chưa đóng / hủy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1677FF;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="615" y="2048" width="300" height="110" as="geometry"/></mxCell><mxCell id="p4-v2-247" value="XEM TRƯỚC&lt;br&gt;buổi hợp lệ (xanh)&lt;br&gt;buổi bị trùng (đỏ + lý do)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1677FF;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="945" y="2048" width="230" height="110" as="geometry"/></mxCell><mxCell id="p4-v2-248" value="Người dùng chọn:&lt;br&gt;• lưu, bỏ qua buổi trùng&lt;br&gt;• hoặc dừng, đổi giờ / phòng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1677FF;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1205" y="2048" width="220" height="110" as="geometry"/></mxCell><mxCell id="p4-v2-249" value="LƯU trong 1 transaction&lt;br&gt;POST …/schedules/bulk&lt;br&gt;khóa tài nguyên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1677FF;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1455" y="2048" width="180" height="110" as="geometry"/></mxCell><mxCell id="p4-v2-250" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-244" target="p4-v2-245"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-251" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-245" target="p4-v2-246"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-252" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-246" target="p4-v2-247"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-253" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-247" target="p4-v2-248"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-254" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-248" target="p4-v2-249"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-255" value="Phòng học là tài nguyên cấp TỔ CHỨC: phòng ban có module lịch được chọn mọi phòng đang hoạt động. Mã lỗi giữ nguyên 3110 / 3111 / 3112." style="text;html=1;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="55" y="2197" width="1560" height="30" as="geometry"/></mxCell><mxCell id="p4-v2-256" value="8. LIÊN ĐỘNG LỊCH — sự kiện ở lớp, nhân sự, phòng kéo theo buổi học" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CF1322;strokeColor=#CF1322;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="35" y="2255" width="1650" height="38" as="geometry"/></mxCell><mxCell id="p4-v2-257" value="" style="rounded=1;fillColor=#FFF1F0;strokeColor=#CF1322;strokeWidth=1;opacity=28;" vertex="1" parent="1"><mxGeometry x="35" y="2293" width="1650" height="300" as="geometry"/></mxCell><mxCell id="p4-v2-258" value="Lớp bị HỦY hoặc ĐÓNG&lt;br&gt;(đã được duyệt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CF1322;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="2313" width="340" height="70" as="geometry"/></mxCell><mxCell id="p4-v2-259" value="Hủy mọi buổi CHƯA diễn ra (status = cancelled)&lt;br&gt;không đụng tới buổi đã diễn ra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CF1322;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="470" y="2313" width="520" height="70" as="geometry"/></mxCell><mxCell id="p4-v2-260" value="Thông báo giáo viên + sinh viên trong lớp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CF1322;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1065" y="2313" width="380" height="70" as="geometry"/></mxCell><mxCell id="p4-v2-261" value="Giáo viên NGHỈ VIỆC hoặc CHUYỂN PHÒNG&lt;br&gt;(đã duyệt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CF1322;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="2403" width="340" height="70" as="geometry"/></mxCell><mxCell id="p4-v2-262" value="Gắn cờ 'cần phân công lại' cho lớp&lt;br&gt;và các buổi tương lai của giáo viên đó" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CF1322;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="470" y="2403" width="520" height="70" as="geometry"/></mxCell><mxCell id="p4-v2-263" value="Thông báo người quản lý lớp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CF1322;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1065" y="2403" width="380" height="70" as="geometry"/></mxCell><mxCell id="p4-v2-264" value="Phòng chuyển BẢO TRÌ&lt;br&gt;hoặc có thiết bị HỎNG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CF1322;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="2493" width="340" height="70" as="geometry"/></mxCell><mxCell id="p4-v2-265" value="Liệt kê buổi tương lai bị ảnh hưởng&lt;br&gt;(KHÔNG tự hủy, người xếp lịch quyết định)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CF1322;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="470" y="2493" width="520" height="70" as="geometry"/></mxCell><mxCell id="p4-v2-266" value="Cảnh báo người xếp lịch + nhân viên CSVC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CF1322;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1065" y="2493" width="380" height="70" as="geometry"/></mxCell><mxCell id="p4-v2-267" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-258" target="p4-v2-259"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-268" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-259" target="p4-v2-260"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-269" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-261" target="p4-v2-262"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-270" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-262" target="p4-v2-263"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-271" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-264" target="p4-v2-265"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-272" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-265" target="p4-v2-266"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-273" value="9. ĐỔI LỊCH / DẠY BÙ VÀ ĐIỂM DANH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#722ED1;strokeColor=#722ED1;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="35" y="2615" width="1650" height="38" as="geometry"/></mxCell><mxCell id="p4-v2-274" value="" style="rounded=1;fillColor=#F9F0FF;strokeColor=#722ED1;strokeWidth=1;opacity=28;" vertex="1" parent="1"><mxGeometry x="35" y="2653" width="1650" height="320" as="geometry"/></mxCell><mxCell id="p4-v2-275" value="GIÁO VIÊN gửi yêu cầu&lt;br&gt;đổi lịch / dạy bù / nghỉ&lt;br&gt;+ lý do" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="2673" width="280" height="80" as="geometry"/></mxCell><mxCell id="p4-v2-276" value="Duyệt leo thang (luồng 6)&lt;br&gt;Trưởng phòng → Tổng quản lý → OWNER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="375" y="2673" width="300" height="80" as="geometry"/></mxCell><mxCell id="p4-v2-277" value="Duyệt: tạo / đổi buổi học&lt;br&gt;(kiểm tra trùng như luồng 7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="715" y="2673" width="290" height="80" as="geometry"/></mxCell><mxCell id="p4-v2-278" value="Thông báo lớp&lt;br&gt;và giáo viên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1045" y="2673" width="250" height="80" as="geometry"/></mxCell><mxCell id="p4-v2-279" value="Từ chối: giữ lịch cũ + lý do" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="715" y="2778" width="290" height="60" as="geometry"/></mxCell><mxCell id="p4-v2-280" value="Buổi học diễn ra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="2868" width="280" height="80" as="geometry"/></mxCell><mxCell id="p4-v2-281" value="GIÁO VIÊN điểm danh&lt;br&gt;(có mặt / vắng / trễ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="375" y="2868" width="300" height="80" as="geometry"/></mxCell><mxCell id="p4-v2-282" value="Job đêm: buổi đã qua giờ&lt;br&gt;→ status = completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="715" y="2868" width="290" height="80" as="geometry"/></mxCell><mxCell id="p4-v2-283" value="SINH VIÊN xem chuyên cần của mình&lt;br&gt;/sinh-vien/chuyen-can" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1045" y="2868" width="340" height="80" as="geometry"/></mxCell><mxCell id="p4-v2-284" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-275" target="p4-v2-276"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-285" value="duyệt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-276" target="p4-v2-277"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-286" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-277" target="p4-v2-278"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-287" value="từ chối" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-276" target="p4-v2-279"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-288" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-280" target="p4-v2-281"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-289" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-281" target="p4-v2-282"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-290" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-282" target="p4-v2-283"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-291" value="10. TRẠNG THÁI LỚP TỰ ĐỘNG — tính khi đọc + job chạy mỗi đêm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D48806;strokeColor=#D48806;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="35" y="2995" width="1650" height="38" as="geometry"/></mxCell><mxCell id="p4-v2-292" value="" style="rounded=1;fillColor=#FFFBE6;strokeColor=#D48806;strokeWidth=1;opacity=28;" vertex="1" parent="1"><mxGeometry x="35" y="3033" width="1650" height="150" as="geometry"/></mxCell><mxCell id="p4-v2-293" value="MỖI LẦN ĐỌC LỚP&lt;br&gt;tính trạng thái từ ngày bắt đầu / kết thúc&lt;br&gt;(luôn đúng, không phụ thuộc job)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D48806;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="3058" width="320" height="90" as="geometry"/></mxCell><mxCell id="p4-v2-294" value="CHUA_BAT_DAU → DANG_DIEN_RA&lt;br&gt;→ DA_KET_THUC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D48806;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="415" y="3058" width="360" height="90" as="geometry"/></mxCell><mxCell id="p4-v2-295" value="JOB @Scheduled MỖI ĐÊM&lt;br&gt;ghi class_status_log, gửi thông báo,&lt;br&gt;đồng bộ cột status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D48806;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="815" y="3058" width="380" height="90" as="geometry"/></mxCell><mxCell id="p4-v2-296" value="KHÔNG ghi đè trạng thái đặt tay&lt;br&gt;(DA_HUY, đóng lớp CLOSED)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D48806;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1235" y="3058" width="390" height="90" as="geometry"/></mxCell><mxCell id="p4-v2-297" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-293" target="p4-v2-294"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-298" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-294" target="p4-v2-295"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-v2-299" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#595959;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-v2-295" target="p4-v2-296"><mxGeometry relative="1" as="geometry"/></mxCell></root>
