  <diagram id="p5" name="5. Danh mục quyền, bundle &amp; cách tính quyền">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1520" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p5-n1" value="5. DANH MỤC QUYỀN — BUNDLE — CHỨC VỤ MẶC ĐỊNH — CÁCH TÍNH QUYỀN HIỆU LỰC" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="35" y="16" width="1650" height="40" as="geometry"/></mxCell>
        <mxCell id="p5-n2" value="Mã quyền dạng &lt;module&gt;.&lt;resource&gt;.&lt;action&gt;; module_code = NULL nghĩa là quyền nhân sự dùng chung cho mọi phòng ban." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="35" y="58" width="1650" height="28" as="geometry"/></mxCell>
        <mxCell id="p5-n3" value="CÔNG THỨC QUYỀN HIỆU LỰC&lt;br&gt;Quyền hiệu lực = quyền của ROLE hệ thống  ∪  quyền của CHỨC VỤ  ∪  quyền từ BUNDLE của chức vụ  ∪  quyền từ ỦY QUYỀN còn hiệu lực&lt;br&gt;Sau đó lọc theo: (1) department_member đang ACTIVE   (2) assignment đang ACTIVE trong thời hạn   (3) allowed_scopes của quyền chứa ORGANIZATION hoặc DEPARTMENT phù hợp   (4) module đang bật ở tổ chức VÀ phòng ban.&lt;br&gt;OWNER bỏ qua bước lọc quyền (hasRole('OWNER')), nhưng vẫn phải đúng tổ chức (org_id lấy từ JWT)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4FF;strokeColor=#1677FF;strokeWidth=1;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="35" y="96" width="1650" height="90" as="geometry"/></mxCell>
        <mxCell id="p5-n4" value="HR_MANAGEMENT&lt;br&gt;Quản lý nhân sự" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FA8C16;strokeColor=#FA8C16;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="35" y="210" width="390" height="56" as="geometry"/></mxCell>
        <mxCell id="p5-n5" value="• employee.view&lt;br&gt;• employee.create&lt;br&gt;• employee.edit&lt;br&gt;• employee.delete&lt;br&gt;• employee.reset_password&lt;br&gt;• employee.assign_position&lt;br&gt;• employee.view_detail&lt;br&gt;• employee.resign&lt;br&gt;• employee.approve_resignation&lt;br&gt;• employee.transfer&lt;br&gt;• employee.approve_transfer&lt;br&gt;• position.view&lt;br&gt;• position.manage&lt;br&gt;• department.view" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FA8C16;strokeWidth=1.5;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="35" y="266" width="390" height="300" as="geometry"/></mxCell>
        <mxCell id="p5-n6" value="ACADEMIC_MANAGEMENT&lt;br&gt;Quản lý đào tạo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#52C41A;strokeColor=#52C41A;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="445" y="210" width="390" height="56" as="geometry"/></mxCell>
        <mxCell id="p5-n7" value="• student.view&lt;br&gt;• student.create&lt;br&gt;• student.edit&lt;br&gt;• student.delete&lt;br&gt;• student.create_account&lt;br&gt;• class.view&lt;br&gt;• class.create&lt;br&gt;• class.edit&lt;br&gt;• class.delete&lt;br&gt;• class.assign_teacher&lt;br&gt;• class.teacher.reassign&lt;br&gt;• class.cancel&lt;br&gt;• class.request_close&lt;br&gt;• class.approve_close&lt;br&gt;• class.reopen&lt;br&gt;• class.view_reassign&lt;br&gt;• student.change_status&lt;br&gt;• student.reset_account&lt;br&gt;• subject.view&lt;br&gt;• subject.manage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#52C41A;strokeWidth=1.5;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="445" y="266" width="390" height="400" as="geometry"/></mxCell>
        <mxCell id="p5-n8" value="SCHEDULE_MANAGEMENT&lt;br&gt;Quản lý lịch học" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1677FF;strokeColor=#1677FF;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="855" y="210" width="390" height="56" as="geometry"/></mxCell>
        <mxCell id="p5-n9" value="• schedule.view&lt;br&gt;• schedule.create&lt;br&gt;• schedule.edit&lt;br&gt;• schedule.update&lt;br&gt;• schedule.cancel_session&lt;br&gt;• schedule.delete&lt;br&gt;• schedule.recurring.create&lt;br&gt;• schedule.preview&lt;br&gt;• schedule.attendance.mark&lt;br&gt;• schedule.attendance.view&lt;br&gt;• schedule.change_request.create&lt;br&gt;• schedule.change_request.approve&lt;br&gt;• (schedule.self_view là quyền SELF, không nằm trong bundle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1677FF;strokeWidth=1.5;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="855" y="266" width="390" height="400" as="geometry"/></mxCell>
        <mxCell id="p5-n10" value="FACILITY_MANAGEMENT&lt;br&gt;Quản lý cơ sở vật chất" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#722ED1;strokeColor=#722ED1;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1265" y="210" width="390" height="56" as="geometry"/></mxCell>
        <mxCell id="p5-n11" value="• facility.view&lt;br&gt;• facility.manage&lt;br&gt;• facility.room.view&lt;br&gt;• facility.room.create&lt;br&gt;• facility.room.update&lt;br&gt;• facility.room.delete&lt;br&gt;• facility.equipment.view&lt;br&gt;• facility.equipment.create&lt;br&gt;• facility.equipment.update&lt;br&gt;• facility.equipment.delete&lt;br&gt;• facility.issue.report&lt;br&gt;• facility.issue.resolve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#722ED1;strokeWidth=1.5;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1265" y="266" width="390" height="300" as="geometry"/></mxCell>
        <mxCell id="p5-n12" value="QUYỀN SELF (gắn trực tiếp role STUDENT)&lt;br&gt;&lt;br&gt;• student.self_view&lt;br&gt;• class.self_view&lt;br&gt;• schedule.self_view&lt;br&gt;• attendance.self_view&lt;br&gt;&lt;br&gt;Không nằm trong bundle; không cấp qua chức vụ.&lt;br&gt;Chỉ dùng cho cổng /sinh-vien và /lich-cua-toi." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9F0FF;strokeColor=#722ED1;strokeWidth=1;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontColor=#614700;" vertex="1" parent="1"><mxGeometry x="1265" y="590" width="390" height="170" as="geometry"/></mxCell>
        <mxCell id="p5-n13" value="CHỨC VỤ MẶC ĐỊNH (DefaultPositionSeeder) VÀ QUYỀN ĐI KÈM" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="35" y="700" width="1200" height="30" as="geometry"/></mxCell>
        <mxCell id="p5-n14" value="Chức vụ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EBF0;strokeColor=#8C8C8C;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fontColor=#1F2937;fontSize=12;" vertex="1" parent="1"><mxGeometry x="35" y="740" width="230" height="40" as="geometry"/></mxCell>
        <mxCell id="p5-n15" value="Phạm vi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EBF0;strokeColor=#8C8C8C;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fontColor=#1F2937;fontSize=12;" vertex="1" parent="1"><mxGeometry x="265" y="740" width="120" height="40" as="geometry"/></mxCell>
        <mxCell id="p5-n16" value="Bundle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EBF0;strokeColor=#8C8C8C;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fontColor=#1F2937;fontSize=12;" vertex="1" parent="1"><mxGeometry x="385" y="740" width="220" height="40" as="geometry"/></mxCell>
