        <mxCell id="p5-n25" value="Sinh viên CRUD + đổi trạng thái + reset/khóa TK, môn học CRUD, lớp CRUD, gán GV, hủy/đóng/mở lớp, xem lớp cần phân công lại" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D9D9D9;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="605" y="822" width="630" height="42" as="geometry"/></mxCell>
