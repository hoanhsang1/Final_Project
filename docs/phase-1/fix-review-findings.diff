+             v_chk_total AS chk_0;
+      SIGNAL SQLSTATE '45000'
+        SET MESSAGE_TEXT = 'M52 ABORT: existing specialty_subject is not Revision-3 schema; fix manually';
+    END IF;
+  END ss_check;
+END$
