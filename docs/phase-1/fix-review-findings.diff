+             v_attr_bad AS attr_mismatch_0,
+             v_idx_ok AS idx_ok_2, v_idx_prefix AS idx_prefix_0,
+             v_idx_extra AS idx_extra_0, v_pk AS pk_1,
+             v_fk_total AS fk_2, v_fk_ok AS fk_ok_2,
