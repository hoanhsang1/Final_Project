# MEMS — Mẫu biến môi trường cho backend
#
# CÁCH DÙNG:
#   Windows :  copy .env.example .env
#   macOS/Linux: cp .env.example .env
# Rồi mở file .env vừa tạo và điền các giá trị bên dưới.
#
# ⚠️ KHÔNG commit file .env (đã được .gitignore chặn sẵn ở cả gốc repo và frontend/).
#    Repo này là CÔNG KHAI — đẩy giá trị thật lên đây là để cả thế giới đọc được.
#
# ⚠️ Đặt biến môi trường trước khi chạy `java -jar` (xem README mục 6, cách B).
#    Đặt biến rồi mở cửa sổ terminal mới thì biến sẽ mất.

# --- Tài khoản MySQL ---
DB_USERNAME=
DB_PASSWORD=

# --- Khoá ký JWT ---
# Phải là chuỗi base64 của 32 byte ngẫu nhiên. Tạo bằng:
#   openssl rand -base64 32
# (hoặc PowerShell:  [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 })))
JWT_SECRET_BASE64=

# --- Mật khẩu tài khoản quản trị mẫu ---
# Dùng khi gieo dữ liệu bằng 05_seed_admin.sql.
# Tài khoản: platform_admin
ADMIN_BOOTSTRAP_PASSWORD=

# Department OWNER bootstrap: existing active organization only.
# Existing accounts/passwords are never overwritten. Disable after initial startup.
OWNER_BOOTSTRAP_ENABLED=false
OWNER_BOOTSTRAP_ORG_ID=
OWNER_BOOTSTRAP_EMAIL=
OWNER_BOOTSTRAP_USERNAME=
OWNER_BOOTSTRAP_PASSWORD=

# Shared service-to-service secret, minimum 32 characters. Never expose to frontend.
INTERNAL_API_KEY=
IDENTITY_SERVICE_URL=http://localhost:8081
PEOPLE_SERVICE_URL=http://localhost:8082

# Allowed browser origins for direct service calls; comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173
